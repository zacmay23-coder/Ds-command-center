{
  "rules": {
    ".read": false,
    ".write": false,
    "officers": {
      ".read": false,
      ".write": false
    },
    "desert-storm-master": {
      ".read": "auth != null && root.child('officers').child(auth.uid).val() === true",
      ".write": "auth != null && root.child('officers').child(auth.uid).val() === true",
      ".validate": "newData.hasChildren(['schema','publishedAt','revision','data'])"
    }
  }
}
